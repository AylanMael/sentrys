rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helpers
    ========================= */

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function tuPath() {
      return /databases/$(database)/documents/tenantUsers/$(uid());
    }

    function hasTU() {
      return signedIn() && exists(tuPath())
        && ("status" in get(tuPath()).data)
        && get(tuPath()).data.status == "active";
    }

    function tu() {
      return get(tuPath());
    }

    function myTenantId() {
      // Callers authorize membership once; avoid recursively repeating hasTU.
      return tu().data.get("tenantId", null);
    }

    function myRole() {
      return tu().data.get("role", null);
    }

    function tenantPath() {
      return /databases/$(database)/documents/tenants/$(myTenantId());
    }

    function hasTenant() {
      return hasTU() && myTenantId() is string && exists(tenantPath());
    }

    function platformRecovery() {
      return hasTU() && myTenantId() == "platform" && myRole() == "super_admin";
    }

    function tenantSuspended() {
      return get(tenantPath()).data.get("status", "") == "suspended";
    }

    function commercialSuspension() {
      return hasTenant() && tenantSuspended()
        && get(tenantPath()).data.get("suspensionMode", "security") == "commercial";
    }

    function canReadTenantData() {
      return hasTenant()
        && (platformRecovery() || !tenantSuspended() || commercialSuspension());
    }

    function canWriteTenantData() {
      return hasTenant() && (platformRecovery() || !tenantSuspended());
    }

    function isSuperAdmin() {
      return hasTU() && myRole() == "super_admin";
    }

    function isOwner() {
      return hasTU() && myRole() == "owner";
    }

    function isAdmin() {
      return hasTU() && myRole() in ["super_admin", "owner", "admin"];
    }

    function isManager() {
      return hasTU() && myRole() in ["super_admin", "owner", "admin", "manager"];
    }

    function isViewer() {
      return hasTU() && myRole() == "viewer";
    }

    function isAgent() {
      return hasTU() && myRole() == "agent";
    }

    function isClient() {
      return hasTU() && myRole() == "client";
    }
    function myAgentId() {
      return hasTU() && ("agentId" in tu().data) && tu().data.agentId is string && tu().data.agentId.size() > 0
        ? tu().data.agentId
        : uid();
    }

    function isOwnAgent(agentId) {
      return isAgent() && myAgentId() == agentId;
    }

    function canReadBackoffice() {
      return hasTU() && myRole() in ["super_admin", "owner", "admin", "manager", "viewer"];
    }

    function canManagePlanning() {
      return hasTU() && myRole() in ["super_admin", "owner", "admin", "manager"];
    }

    function sameTenantOnCreate() {
      return hasTU()
        && ("tenantId" in request.resource.data)
        && request.resource.data.tenantId == myTenantId();
    }

    function sameTenantResource() {
      return hasTU()
        && ("tenantId" in resource.data)
        && resource.data.tenantId == myTenantId();
    }

    function forbidChange(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    /* =========================
       Sites helpers
    ========================= */

    function sitePath(siteId) {
      return /databases/$(database)/documents/sites/$(siteId);
    }

    function siteExists(siteId) {
      return (siteId is string) && exists(sitePath(siteId));
    }

    function siteSameTenant(siteId) {
      return siteExists(siteId)
        && get(sitePath(siteId)).data.tenantId == myTenantId();
    }

    // Assignation site :
    // - accessUids
    // - ou legacy managerIds / agentIds
    function isAssignedToSite(siteId) {
      return hasTU()
        && siteExists(siteId)
        && get(sitePath(siteId)).data.tenantId == myTenantId()
        && (
          (
            ("accessUids" in get(sitePath(siteId)).data)
            && (get(sitePath(siteId)).data.accessUids is list)
            && get(sitePath(siteId)).data.accessUids.hasAny([uid()])
          )
          ||
          (
            ("managerIds" in get(sitePath(siteId)).data)
            && (get(sitePath(siteId)).data.managerIds is list)
            && get(sitePath(siteId)).data.managerIds.hasAny([uid()])
          )
          ||
          (
            ("agentIds" in get(sitePath(siteId)).data)
            && (get(sitePath(siteId)).data.agentIds is list)
            && get(sitePath(siteId)).data.agentIds.hasAny([uid()])
          )
        );
    }

    function accessUidsIsUnion(data) {
      return ("managerIds" in data)
        && ("agentIds" in data)
        && ("accessUids" in data)
        && (data.managerIds is list)
        && (data.agentIds is list)
        && (data.accessUids is list)
        && data.accessUids.hasAll(data.managerIds)
        && data.accessUids.hasAll(data.agentIds)
        && data.managerIds.concat(data.agentIds).hasAll(data.accessUids);
    }

    // Legacy planning classifies absences from title/notes. Keep this narrow
    // exception fail-closed for those records as well as explicit absence flags.
    function absenceText(value) {
      return value is string
        && value.lower().matches('(?s).*(absence|conge|congé|maladie|repos|rtt|vacances).*');
    }

    function ongoingAssignedVacation(vacationId, tenantId, agentId, cutoff) {
      let path = /databases/$(database)/documents/vacations/$(vacationId);
      let vacation = get(path).data;
      return exists(path)
        && vacation.tenantId == tenantId
        && vacation.siteId == request.resource.data.siteId
        && vacation.assignedAgentIds is list
        && agentId is string
        && vacation.assignedAgentIds.hasAny([agentId])
        && cutoff is timestamp
        && vacation.startAt is timestamp && vacation.endAt is timestamp
        && vacation.startAt <= cutoff
        && cutoff <= request.time
        && vacation.startAt <= request.time && request.time < vacation.endAt
        && vacation.status is string
        && !(vacation.status.lower() in ["cancelled", "canceled", "closed", "completed", "absence"])
        && vacation.get("isAbsence", false) == false
        && vacation.get("isDeleted", false) == false
        && !absenceText(vacation.get("type", null))
        && !absenceText(vacation.get("kind", null))
        && !absenceText(vacation.get("missionType", null))
        && !absenceText(vacation.get("title", null))
        && !absenceText(vacation.get("notes", null));
    }

    function commercialIncidentException() {
      let member = tu().data;
      let tenant = get(/databases/$(database)/documents/tenants/$(member.tenantId)).data;
      let linkedId = member.get("agentId", null);
      let agentId = linkedId is string && linkedId.size() > 0 ? linkedId : uid();
      return member.status == "active" && member.role == "agent"
        && tenant.status == "suspended" && tenant.get("suspensionMode", "security") == "commercial"
        && request.resource.data.createdBy == uid()
        && request.resource.data.vacationId is string
        && request.resource.data.vacationId.size() > 0
        && !request.resource.data.vacationId.matches('.*[/].*')
        && ongoingAssignedVacation(request.resource.data.vacationId, member.tenantId, agentId, tenant.get("suspendedAt", null));
    }

    /* =========================
       tenantUsers
       Recommandation :
       création côté backend uniquement
    ========================= */

    match /tenantUsers/{userId} {

      function validSelfProfileUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(["name", "updatedAt"])
          && (!changed.hasAny(["name"])
            || (("name" in request.resource.data)
              && request.resource.data.name is string
              && request.resource.data.name.size() >= 1
              && request.resource.data.name.size() <= 120))
          && (!changed.hasAny(["updatedAt"])
            || (("updatedAt" in request.resource.data)
              && request.resource.data.updatedAt is timestamp));
      }

      allow create: if false;

      allow read: if signedIn()
        && (
          userId == uid()
          || (canReadTenantData() && isManager() && resource.data.tenantId == myTenantId())
        );

      // Tous les champs d'autorité restent serveur uniquement, quel que soit le rôle.
      allow update: if canWriteTenantData()
        && userId == uid()
        && validSelfProfileUpdate();

      allow delete: if false;
    }

    /* =========================
       tenants
       Recommandation :
       création côté backend uniquement
    ========================= */

    match /tenants/{tenantId} {

      allow create: if false;

      allow read: if canReadTenantData() && tenantId == myTenantId();

      allow update: if false;

      allow delete: if false;
    }

    /* =========================
       sites
    ========================= */

    match /sites/{id} {

      allow create: if canWriteTenantData() && canManagePlanning()
        && sameTenantOnCreate()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.isActive is bool
        && accessUidsIsUnion(request.resource.data)
        && request.resource.data.managerIds.hasAny([uid()]);

      allow read: if canReadTenantData() && sameTenantResource()
        && (
          canReadBackoffice()
          || isAssignedToSite(id)
        );

      allow update: if canWriteTenantData() && sameTenantResource()
        && canManagePlanning()
        && forbidChange(["tenantId", "createdAt", "createdBy"])
        && accessUidsIsUnion(request.resource.data);

      allow delete: if canWriteTenantData() && isAdmin() && sameTenantResource();
    }

    /* =========================
       agents
    ========================= */

    match /agents/{id} {

      // File references are maintained only by the authenticated server routes.
      function noFileReferencesOnCreate() {
        let profile = request.resource.data.get("profile", {});
        return !request.resource.data.keys().hasAny(["documents", "photoUrl", "photoPath"])
          && profile is map
          && !profile.keys().hasAny(["documents", "photoUrl", "photoPath"]);
      }

      function fileReferencesUnchanged() {
        let before = resource.data.get("profile", {});
        let after = request.resource.data.get("profile", {});
        return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["documents", "photoUrl", "photoPath"])
          && (!resource.data.keys().hasAny(["documents", "photoUrl", "photoPath"])
            || (("profile" in resource.data) == ("profile" in request.resource.data)))
          && (before == after || (before is map && after is map
            && !after.diff(before).affectedKeys().hasAny(["documents", "photoUrl", "photoPath"])));
      }

      allow create: if canWriteTenantData() && canManagePlanning()
        && sameTenantOnCreate()
        && noFileReferencesOnCreate()
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.status in ["active", "inactive", "disabled"];

      allow read: if canReadTenantData() && sameTenantResource()
        && (
          canManagePlanning()
          || isOwnAgent(id)
        );

      allow update: if canWriteTenantData() && canManagePlanning()
        && sameTenantResource()
        && fileReferencesUnchanged()
        && forbidChange(["tenantId", "createdAt", "createdBy"]);

      allow delete: if canWriteTenantData() && isAdmin() && sameTenantResource();
    }

    /* =========================
       incidents
    ========================= */

    match /incidents/{id} {

      allow create: if hasTU()
        && sameTenantOnCreate()
        && request.resource.data.siteId is string
        && siteSameTenant(request.resource.data.siteId)
        && (
          (canWriteTenantData()
            && (canReadBackoffice() || isAssignedToSite(request.resource.data.siteId)))
          || commercialIncidentException()
        )
        && request.resource.data.description is string
        && request.resource.data.status in ["Ouvert", "Clos", "ouvert", "clos"]
        && request.resource.data.severity in [
          "Faible", "Moyenne", "Élevée",
          "faible", "moyenne", "elevee", "élevée"
        ];

      allow read: if canReadTenantData() && sameTenantResource()
        && (
          canReadBackoffice()
          || isAssignedToSite(resource.data.siteId)
        );

      allow update: if canWriteTenantData() && sameTenantResource()
        && (
          (
            canManagePlanning()
            && forbidChange(["tenantId", "createdAt", "createdBy", "siteId"])
          )
          ||
          (
            isAgent()
            && isAssignedToSite(resource.data.siteId)
            && forbidChange([
              "tenantId",
              "createdAt",
              "createdBy",
              "siteId",
              "severity",
              "siteName"
            ])
          )
        );

      allow delete: if canWriteTenantData() && isAdmin() && sameTenantResource();

      match /comments/{commentId} {

        function incidentOk() {
          return hasTU()
            && exists(/databases/$(database)/documents/incidents/$(id))
            && get(/databases/$(database)/documents/incidents/$(id)).data.tenantId == myTenantId();
        }

        function canSeeIncidentSite() {
          return canReadBackoffice()
            || isAssignedToSite(
              get(/databases/$(database)/documents/incidents/$(id)).data.siteId
            );
        }

        allow read: if canReadTenantData() && incidentOk() && canSeeIncidentSite();

        allow create: if canWriteTenantData() && incidentOk()
          && canSeeIncidentSite()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }

    /* =========================
       vacations
    ========================= */

    match /vacations/{id} {

      function isAssignedToVacation() {
        return isAgent()
          && resource.data.assignedAgentIds is list
          && myAgentId() in resource.data.assignedAgentIds
          && isAssignedToSite(resource.data.siteId);
      }

      allow create: if canWriteTenantData() && canManagePlanning()
        && sameTenantOnCreate()
        && request.resource.data.siteId is string
        && siteSameTenant(request.resource.data.siteId)
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.requiredAgents is int;

      allow get: if canReadTenantData() && sameTenantResource()
        && (canReadBackoffice() || isAssignedToVacation());

      // Agents list missions through the tenant/agent-scoped API, not raw SDK queries.
      allow list: if canReadTenantData() && sameTenantResource() && canReadBackoffice();

      allow update: if canWriteTenantData() && sameTenantResource()
        && canManagePlanning()
        && forbidChange(["tenantId", "createdAt", "createdBy"]);

      allow delete: if canWriteTenantData() && isAdmin() && sameTenantResource();
    }

    /* =========================
       assignments
    ========================= */

    match /assignments/{id} {

      allow create: if canWriteTenantData() && canManagePlanning()
        && sameTenantOnCreate()
        && request.resource.data.agentId is string
        && request.resource.data.vacationId is string
        && request.resource.data.siteId is string
        && siteSameTenant(request.resource.data.siteId);

      allow read: if canReadTenantData() && sameTenantResource()
        && (
          canReadBackoffice()
          || isOwnAgent(resource.data.agentId)
        );

      allow update: if canWriteTenantData() && sameTenantResource()
        && (
          (
            canManagePlanning()
            && forbidChange(["tenantId", "createdAt", "createdBy", "agentId", "vacationId"])
          )
          ||
          (
            // Agent self-update (e.g. for simple status changes if not via API)
            // Note: If all status changes go through API, we can keep this false or very restricted.
            // For now, let's allow it if it's the assigned agent.
            resource.data.agentId == uid()
            && forbidChange(["tenantId", "createdAt", "createdBy", "agentId", "vacationId", "siteId"])
          )
        );

      allow delete: if canWriteTenantData() && isAdmin() && sameTenantResource();
    }

    /* =========================
       Default deny
    ========================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
